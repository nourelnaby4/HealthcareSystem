{
  "ConnectionStrings": {
    "Healthcare": "Host=localhost;Database=healthcare;Username=healthcare;Password=healthcare;Include Error Detail=true"
  },
  "Jwt": {
    "Issuer": "healthcare-api",
    "Audience": "healthcare-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Bootstrap": {
    "UserName": "admin",
    "Email": "admin@healthcare.local",
    "Password": "Boot-Str@p123!"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithSpan" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj} traceId={TraceId} spanId={SpanId}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
